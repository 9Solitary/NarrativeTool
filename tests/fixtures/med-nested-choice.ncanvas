  "project": {
    "title": "MED Nested Choice",
    "notes": "Tests WR-01: a Choice node that is the target of another choice's option in MED mode must not re-emit merged mutations or stray [if]/[else]/[/if] block lines — per-option mutations and inline [if cond /] suffixes only.",
    "variables": {
      "flag_honest": true,
      "res_coins": 5
    },
    "nodes": [
      {
        "id": "n0",
        "type": "Entry",
        "title": "Start",
        "body": "",
        "x": 80,
        "y": 80
      },
      {
        "id": "n1",
        "type": "Choice",
        "title": "Merchant",
        "body": "What do you want to buy?",
        "choices": ["Pay the toll", "Walk away"],
        "choiceOptions": [
          {
            "id": "opt_pay",
            "label": "Pay the toll",
            "requires": "res_coins >= 5",
            "effects": [
              { "trigger": "onChoose", "op": "subtract", "key": "res_coins", "value": "5" }
            ]
          },
          {
            "id": "opt_walk",
            "label": "Walk away",
            "requires": "",
            "effects": []
          }
        ],
        "x": 320,
        "y": 80
      },
      {
        "id": "n2",
        "type": "Choice",
        "title": "Merchant",
        "body": "Hand over 5 coins?",
        "choices": ["Yes", "No"],
        "choiceOptions": [
          {
            "id": "opt_yes",
            "label": "Yes",
            "requires": "flag_honest == true",
            "effects": [
              { "trigger": "onChoose", "op": "set_flag", "key": "flag_paid", "value": "true" }
            ]
          },
          {
            "id": "opt_no",
            "label": "No",
            "requires": "",
            "effects": []
          }
        ],
        "x": 560,
        "y": 20
      },
      {
        "id": "n3",
        "type": "Content",
        "title": "Paid",
        "body": "The merchant smiles and hands you the key.",
        "x": 800,
        "y": 0
      },
      {
        "id": "n4",
        "type": "Content",
        "title": "Refused",
        "body": "The merchant frowns and turns away.",
        "x": 800,
        "y": 140
      },
      {
        "id": "n5",
        "type": "Content",
        "title": "Leave",
